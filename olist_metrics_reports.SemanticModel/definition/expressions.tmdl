expression stg_reviews_latest =
		let
		    Source = fnReadCsv("olist_order_reviews_dataset.csv"),
		    Kept = Table.SelectColumns(Source, {"order_id", "review_score", "review_answer_timestamp"}),
		    Typed = Table.TransformColumnTypes(
		        Kept,
		        {{"order_id", type text}, {"review_score", Int64.Type}, {"review_answer_timestamp", type datetime}},
		        "en-US"
		    ),
		    // some orders have several reviews: keep the most recent answer (= arg_max in Project 3)
		    Latest = Table.Group(
		        Typed,
		        {"order_id"},
		        {{"review_score", each Table.Max(_, "review_answer_timestamp")[review_score], Int64.Type}}
		    )
		in
		    Latest
	lineageTag: 3d33bad1-e18b-4456-a3be-e910947adf82
	queryGroup: Staging

	annotation PBI_ResultType = Table

