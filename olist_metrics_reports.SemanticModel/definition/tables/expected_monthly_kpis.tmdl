	partition expected_monthly_kpis = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\Users\veysel\Desktop\Projects\Datascience_Portfolio\project3plus_powerbi\reconciliation\expected_monthly_kpis.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {
				            {"purchase_month", type date}, {"orders", Int64.Type}, {"gmv", type number},
				            {"delivered", Int64.Type}, {"on_time", Int64.Type}, {"good_orders", Int64.Type},
				            {"promised_days", type number}, {"new_customers", Int64.Type},
				            {"delivered_rate", type number}, {"on_time_rate", type number}, {"good_review_rate", type number}
				        },
				        "en-US"
				    )
				in
				    Typed

