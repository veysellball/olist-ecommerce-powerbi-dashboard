table dim_product
	lineageTag: a60cb7f0-819f-4adc-8b5a-21257880151e

	column product_id
		dataType: string
		lineageTag: 90bc6292-85dc-4fb6-9a62-dc0683d9de00
		summarizeBy: none
		sourceColumn: product_id

		annotation SummarizationSetBy = Automatic

	column category
		dataType: string
		lineageTag: a4ac8c86-ab90-45f8-99da-91fd76854c9a
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

	partition dim_product = m
		mode: import
		queryGroup: Model
		source =
				let
				    Products = Table.SelectColumns(fnReadCsv("olist_products_dataset.csv"), {"product_id", "product_category_name"}),
				    Translation = fnReadCsv("product_category_name_translation.csv"),
				    Merged = Table.NestedJoin(Products, {"product_category_name"}, Translation, {"product_category_name"}, "t", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Merged, "t", {"product_category_name_english"}),
				    Category = Table.AddColumn(Expanded, "category",
				        each if [product_category_name_english] <> null and [product_category_name_english] <> "" then [product_category_name_english]
				             else if [product_category_name] <> "" then [product_category_name]
				             else "unknown",
				        type text),
				    Kept = Table.SelectColumns(Category, {"product_id", "category"})
				in
				    Kept

	annotation PBI_ResultType = Table

