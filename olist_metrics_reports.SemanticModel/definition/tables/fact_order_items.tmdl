	partition fact_order_items = m
		mode: import
		queryGroup: Model
		source =
				let
				    // inner join = only items whose order is inside the model's window
				    InWindow = Table.NestedJoin(stg_items, {"order_id"}, fact_orders, {"order_id"}, "o", JoinKind.Inner),
				    Expanded = Table.ExpandTableColumn(InWindow, "o", {"is_valid_purchase", "purchase_date"}),
				    Kept = Table.SelectColumns(Expanded, {
				        "order_id", "order_item_id", "product_id", "seller_id", "price", "freight_value",
				        "is_valid_purchase", "purchase_date"
				    })
				in
				    Kept

	annotation PBI_ResultType = Table

