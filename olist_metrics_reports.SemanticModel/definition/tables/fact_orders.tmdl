		annotation SummarizationSetBy = Automatic

	partition fact_orders = m
		mode: import
		queryGroup: Model
		source =
				let
				    // 1. the person behind the order (Olist's customer_id is per ORDER, not per person)
				    WithCustomer = Table.NestedJoin(stg_orders, {"customer_id"}, stg_customers, {"customer_id"}, "c", JoinKind.Inner),
				    ExpandCustomer = Table.ExpandTableColumn(WithCustomer, "c", {"customer_unique_id"}),
				
				    // 2. item value and freight aggregated to ONE row per order BEFORE joining (grain!)
				    ItemsByOrder = Table.Group(
				        stg_items,
				        {"order_id"},
				        {
				            {"item_value", each List.Sum([price]), type number},
				            {"freight_value", each List.Sum([freight_value]), type number}
				        }
				    ),
				    WithItems = Table.NestedJoin(ExpandCustomer, {"order_id"}, ItemsByOrder, {"order_id"}, "i", JoinKind.LeftOuter),
				    ExpandItems = Table.ExpandTableColumn(WithItems, "i", {"item_value", "freight_value"}),
				    NoNullValue = Table.ReplaceValue(ExpandItems, null, 0, Replacer.ReplaceValue, {"item_value", "freight_value"}),
				
				    // 3. latest review score
				    WithReview = Table.NestedJoin(NoNullValue, {"order_id"}, stg_reviews_latest, {"order_id"}, "r", JoinKind.LeftOuter),
				    ExpandReview = Table.ExpandTableColumn(WithReview, "r", {"review_score"}),
				
				    // 4. business flags: same rules as ORDER_FACTS_SQL
				    PurchaseDate = Table.AddColumn(ExpandReview, "purchase_date", each Date.From([order_purchase_timestamp]), type date),
				    IsValid = Table.AddColumn(PurchaseDate, "is_valid_purchase",
				        each not List.Contains({"canceled", "unavailable"}, [order_status]), type logical),
				    IsApproved = Table.AddColumn(IsValid, "is_approved", each [order_approved_at] <> null, type logical),
				    IsShipped = Table.AddColumn(IsApproved, "is_shipped", each [order_delivered_carrier_date] <> null, type logical),
				    IsDelivered = Table.AddColumn(IsShipped, "is_delivered",
				        each [order_status] = "delivered" and [order_delivered_customer_date] <> null, type logical),
				    // day-level comparison: the promise is a DATE, not a timestamp (Project 1 fix)
				    IsOnTime = Table.AddColumn(IsDelivered, "is_on_time",
				        each [is_delivered] and Date.From([order_delivered_customer_date]) <= Date.From([order_estimated_delivery_date]),
				        type logical),
				    PromisedDays = Table.AddColumn(IsOnTime, "promised_days",
				        each Duration.Days(Date.From([order_estimated_delivery_date]) - [purchase_date]), Int64.Type),
				    IsGood = Table.AddColumn(PromisedDays, "is_good_order", each [is_on_time] and ([review_score] ?? 0) >= 4, type logical),
				
				    // 5. first purchase DAY per person, over ALL history, BEFORE the window filter
				    ValidOnly = Table.SelectRows(IsGood, each [is_valid_purchase]),
				    FirstPurchase = Table.Group(ValidOnly, {"customer_unique_id"},
				        {{"first_purchase_date", each List.Min([purchase_date]), type date}}),
				    WithFirst = Table.NestedJoin(IsGood, {"customer_unique_id"}, FirstPurchase, {"customer_unique_id"}, "f", JoinKind.LeftOuter),
				    ExpandFirst = Table.ExpandTableColumn(WithFirst, "f", {"first_purchase_date"}),
				    IsFirst = Table.AddColumn(ExpandFirst, "is_first_purchase",
				        each [is_valid_purchase] and [purchase_date] = [first_purchase_date], type logical),
				
				    // 6. the analysis window: Project 3's START and END
				    Window = Table.SelectRows(IsFirst, each [purchase_date] >= #date(2017, 1, 1) and [purchase_date] <= #date(2018, 8, 31)),
				
				    // 7. keep only what the model needs, with explicit types
				    Kept = Table.SelectColumns(Window, {
				        "order_id", "customer_id", "customer_unique_id", "order_status", "purchase_date",
				        "is_valid_purchase", "is_approved", "is_shipped", "is_delivered", "is_on_time",
				        "is_good_order", "is_first_purchase", "promised_days", "item_value", "freight_value", "review_score"
				    }),
				    Typed = let
				    // 1. the person behind the order (Olist's customer_id is per ORDER, not per person)
				    WithCustomer = Table.NestedJoin(stg_orders, {"customer_id"}, stg_customers, {"customer_id"}, "c", JoinKind.Inner),
				    ExpandCustomer = Table.ExpandTableColumn(WithCustomer, "c", {"customer_unique_id"}),
				
				    // 2. item value and freight aggregated to ONE row per order BEFORE joining (grain!)
				    ItemsByOrder = Table.Group(
				        stg_items,
				        {"order_id"},
				        {
				            {"item_value", each List.Sum([price]), type number},
				            {"freight_value", each List.Sum([freight_value]), type number}
				        }
				    ),
				    WithItems = Table.NestedJoin(ExpandCustomer, {"order_id"}, ItemsByOrder, {"order_id"}, "i", JoinKind.LeftOuter),
				    ExpandItems = Table.ExpandTableColumn(WithItems, "i", {"item_value", "freight_value"}),
				    NoNullValue = Table.ReplaceValue(ExpandItems, null, 0, Replacer.ReplaceValue, {"item_value", "freight_value"}),
				
				    // 3. latest review score
				    WithReview = Table.NestedJoin(NoNullValue, {"order_id"}, stg_reviews_latest, {"order_id"}, "r", JoinKind.LeftOuter),
				    ExpandReview = Table.ExpandTableColumn(WithReview, "r", {"review_score"}),
				
				    // 4. business flags: same rules as ORDER_FACTS_SQL
				    PurchaseDate = Table.AddColumn(ExpandReview, "purchase_date", each Date.From([order_purchase_timestamp]), type date),
				    IsValid = Table.AddColumn(PurchaseDate, "is_valid_purchase",
				        each not List.Contains({"canceled", "unavailable"}, [order_status]), type logical),
				    IsApproved = Table.AddColumn(IsValid, "is_approved", each [order_approved_at] <> null, type logical),
				    IsShipped = Table.AddColumn(IsApproved, "is_shipped", each [order_delivered_carrier_date] <> null, type logical),
				    IsDelivered = Table.AddColumn(IsShipped, "is_delivered",
				        each [order_status] = "delivered" and [order_delivered_customer_date] <> null, type logical),
				    // day-level comparison: the promise is a DATE, not a timestamp (Project 1 fix)
				    IsOnTime = Table.AddColumn(IsDelivered, "is_on_time",
				        each [is_delivered] and Date.From([order_delivered_customer_date]) <= Date.From([order_estimated_delivery_date]),
				        type logical),
				    PromisedDays = Table.AddColumn(IsOnTime, "promised_days",
				        each Duration.Days(Date.From([order_estimated_delivery_date]) - [purchase_date]), Int64.Type),
				    IsGood = Table.AddColumn(PromisedDays, "is_good_order", each [is_on_time] and ([review_score] ?? 0) >= 4, type logical),
				
				    // 5. first purchase DAY per person, over ALL history, BEFORE the window filter
				    ValidOnly = Table.SelectRows(IsGood, each [is_valid_purchase]),
				    FirstPurchase = Table.Group(ValidOnly, {"customer_unique_id"},
				        {{"first_purchase_date", each List.Min([purchase_date]), type date}}),
				    WithFirst = Table.NestedJoin(IsGood, {"customer_unique_id"}, FirstPurchase, {"customer_unique_id"}, "f", JoinKind.LeftOuter),
				    ExpandFirst = Table.ExpandTableColumn(WithFirst, "f", {"first_purchase_date"}),
				    IsFirst = Table.AddColumn(ExpandFirst, "is_first_purchase",
				        each [is_valid_purchase] and [purchase_date] = [first_purchase_date], type logical),
				
				    // 6. the analysis window: Project 3's START and END
				    Window = Table.SelectRows(IsFirst, each [purchase_date] >= #date(2017, 1, 1) and [purchase_date] <= #date(2018, 8, 31)),
				
				    // 7. keep only what the model needs, with explicit types
				    Kept = Table.SelectColumns(Window, {
				        "order_id", "customer_id", "customer_unique_id", "order_status", "purchase_date",
				        "is_valid_purchase", "is_approved", "is_shipped", "is_delivered", "is_on_time",
				        "is_good_order", "is_first_purchase", "promised_days", "item_value", "freight_value", "review_score"
				    }),
				    Typed = Table.TransformColumnTypes(Kept, {
				        {"customer_unique_id", type text}, {"item_value", type number},
				        {"freight_value", type number}, {"review_score", Int64.Type}
				    })
				in
				    Typed
				
				in
				    Typed

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

