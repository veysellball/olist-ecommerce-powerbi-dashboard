	partition dim_date = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2017, 1, 1 ), DATE ( 2018, 12, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm yyyy" )
				)
				
				```

	annotation PBI_Id = 8bcbf1eeadd9464486933d5b4a35656b

